{
  "name": "pillpal",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "agent",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run -ws --if-present typecheck && npm run -ws --if-present build",
    "build": "npm run -ws --if-present build",
    "dev": "echo \"dev: TODO — will run web :3000, api :8787, agent together\" && npm run -w @pillpal/api dev",
    "demo:up": "node scripts/demo-up.mjs",
    "demo:up:sched": "node scripts/demo-up.mjs --sched",
    "test:e2e:web": "node scripts/e2e-web-call.mjs",
    "video:seed": "npm run -s -w @pillpal/api seed:video",
    "video:voices": "npm run -s -w @pillpal/agent video:voices",
    "video:up": "node scripts/video-up.mjs",
    "scene:1": "node scripts/scene.mjs 1",
    "scene:2": "node scripts/scene.mjs 2",
    "scene:reset": "node scripts/scene.mjs reset",
    "test:e2e:video": "node scripts/e2e-video.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "playwright": "1.64.1"
  }
}
